/**
 * @param {string[]} strs
 * @return {string}
 */
var longestCommonPrefix = function(strs) {
    if (!strs || strs.length === 0) return "";
    
    let newString = "";
    const firstWord = strs[0]; 


    for (let i = 0; i < firstWord.length; i++) {
        let char = firstWord[i];

        for (let j = 1; j < strs.length; j++) {

            if (i >= strs[j].length || strs[j][i] !== char) {
                return newString;
            }
        }

        newString += char;
    }

    return newString;
};

